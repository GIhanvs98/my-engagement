# Resend Email Service Configuration
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=re_your_api_key_here

# From Email Address
# Default testing sender on Resend: Engagement RSVP <onboarding@resend.dev>
# Or your custom verified domain: Engagement RSVP <rsvp@yourdomain.com>
RESEND_FROM_EMAIL=Engagement RSVP <onboarding@resend.dev>

# Notification Email Address
# The email address that should receive RSVP notifications whenever a guest responds
RSVP_NOTIFICATION_EMAIL=gihanvs98@gmail.com
